# Zkopíruj do .env.local (negituje se) a vyplň hodnotami z Google Cloud Console.
# Návod krok za krokem: viz PROJECT.md, sekce "Google Disk — nastavení".
# Bez těchto hodnot appka běží normálně dál, jen tlačítka "Z Google Disku" /
# "Uložit na Disk jako nový soubor" zůstanou neaktivní.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
